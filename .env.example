# Server-only application telemetry. Never put the ingestion token in NEXT_PUBLIC_*.
DASH0_OTLP_HTTP_ENDPOINT=https://ingress.us-west-2.aws.dash0.com
DASH0_DATASET=default
DASH0_INGESTION_TOKEN=
SERVICE_VERSION=local

# Set to the exact public origin before enabling bounded client outcome reports.
APP_ORIGIN=http://127.0.0.1:3000

# Defaults below use local paths; containers should set both under /data.
DATABASE_PATH=data/conference.sqlite
ASSET_DIR=data/assets

